<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AutoTrigger'">
    <AT_Win32ResFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)AutoTrigger.res</AT_Win32ResFile>
    <AT_Win32ResScript>$(MSBuildThisFileDirectory)tools\Write-Win32Res.ps1</AT_Win32ResScript>
  </PropertyGroup>

  <Target Name="AT_WriteWin32Res"
          Condition="'$(MSBuildProjectName)' == 'AutoTrigger' and '$(AT_SkipWin32Res)' != 'true' and '$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)Directory.Build.props;$(AT_Win32ResScript);$(MSBuildProjectDirectory)\$(ApplicationManifest);$(MSBuildProjectDirectory)\$(ApplicationIcon)"
          Outputs="$(AT_Win32ResFile)">
    <Exec ContinueOnError="true"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(AT_Win32ResScript)&quot; -Output &quot;$(AT_Win32ResFile)&quot; -Icon &quot;$(MSBuildProjectDirectory)\$(ApplicationIcon)&quot; -Manifest &quot;$(MSBuildProjectDirectory)\$(ApplicationManifest)&quot; -FileVersion &quot;$(FileVersion)&quot; -ProductVersion &quot;$(InformationalVersion)&quot; -Description &quot;$(AssemblyTitle)&quot; -Product &quot;$(Product)&quot; -CopyrightYear &quot;$(CopyrightYear)&quot; -CopyrightHolder &quot;$(CopyrightHolder)&quot; -OriginalFilename &quot;$(TargetFileName)&quot;" />
  </Target>

  <Target Name="AT_UseWin32Res"
          BeforeTargets="CoreCompile"
          DependsOnTargets="AT_WriteWin32Res"
          Condition="'$(MSBuildProjectName)' == 'AutoTrigger' and '$(AT_SkipWin32Res)' != 'true' and '$(OS)' == 'Windows_NT'">
    <PropertyGroup Condition="Exists('$(AT_Win32ResFile)')">
      <Win32Resource>$(AT_Win32ResFile)</Win32Resource>
      <ApplicationIcon></ApplicationIcon>
      <Win32Manifest></Win32Manifest>
      <NoWin32Manifest>true</NoWin32Manifest>
    </PropertyGroup>
    <Warning Condition="!Exists('$(AT_Win32ResFile)')"
             Text="AutoTrigger: Win32 resources not generated; the exe keeps the compiler's default resources (language neutral)." />
  </Target>
</Project>
