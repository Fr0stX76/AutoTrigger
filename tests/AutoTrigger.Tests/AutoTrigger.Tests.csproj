<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AutoTrigger.Tests</AssemblyName>
    <RootNamespace>AutoTrigger.Tests</RootNamespace>
    <AssemblyTitle>AutoTrigger tests</AssemblyTitle>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <IsPackable>false</IsPackable>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\out\Tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoTrigger.Core\AutoTrigger.Core.csproj" />
    <Compile Include="..\..\src\AutoTrigger\CommandChannel.cs" Link="CommandChannel.cs" />
  </ItemGroup>

</Project>
